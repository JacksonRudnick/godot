Import('env')
Import('env_modules')

env_framegen = env_modules.Clone()

# Add all source files to module sources
env_framegen.add_source_files(env.modules_sources, "*.cpp")

# Configure torch library paths and includes
libtorch_lib_path = Dir('libtorch/lib/').abspath

env_framegen.Append(CXXFLAGS=['-isystem', Dir('libtorch/include/').abspath])
env_framegen.Append(CXXFLAGS=['-isystem', Dir('libtorch/include/torch/csrc/api/include/').abspath])
env_framegen.Append(CXXFLAGS=['-fexceptions', '-frtti'])

# Add torch libraries to module environment
env_framegen.Append(LIBPATH=[libtorch_lib_path])
env_framegen.Append(LIBS=['torch', 'torch_cpu', 'c10', 'torch_global_deps'])
env_framegen.Append(LINKFLAGS=['-Wl,-rpath,' + libtorch_lib_path])

# Also add to main environment for final executable linking
env.Append(LIBPATH=[libtorch_lib_path])
env.Append(LIBS=['torch', 'torch_cpu', 'c10', 'torch_global_deps'])
env.Append(LINKFLAGS=['-Wl,-rpath,' + libtorch_lib_path])